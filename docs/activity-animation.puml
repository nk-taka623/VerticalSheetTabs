@startuml
title アニメーションを起動するかどうかの判断 (アクティビティ図)
skinparam shadowing false

start
:同期の結果が TabStrip に届く (SetSheets / SetBadges);

partition "行の追加・削除 (SetRows)" {
  if (行の名前・並びが前回と同じ?) then (はい)
    :動かさない;
  else (いいえ)
    if (RowAnimation が On かつ サンプルでなく、検索中でなく、\n表示されていて、それまでの行がある (最初の表示でない)?) then (はい)
      :増えた行と減った行を数える\n(シートは名前、フォルダは id);
      if (増えた行と減った行の、\n片方だけがある?) then (はい)
        if (減った行?) then (はい)
          :見えている行の絵を作る\n(見えない行は絵なしで、行のずれにだけ関わる。積み上げ方式は、
動く前の最初の行の上端も控える);
        else (増えた行)
          if (増えた行が、閉じたフォルダの中だけ?) then (はい)
            :行が出ないので、動かさない;
          else (いいえ)
            :追加した行の動きを用意する;
          endif
        endif
        :400ms の追加・削除の動きを始める\n(閉じたフォルダの中だけのときは、始めない);
      else (いいえ (名前の変更・並べ直しなど))
        :動かさない;
      endif
    else (いいえ)
      :動かさない;
    endif
  endif
}

partition "揺れ (描くとき)" {
  if (サンプルでなく、アクティブなシートが変わった、\nまたはフォルダの開閉・選択が変わった (最初に見た状態を除く)?) then (はい)
    if (いま追加された行がアクティブ?) then (はい)
      :シートの揺れは始めない\n(その行は、自分の動きで現れる);
    endif
    if (ゴーストが出ている?) then (はい)
      :始めない (落としたあとに始める);
    else (いいえ)
      if (揺れの種類が None?) then (はい)
        :始めない;
      else (いいえ)
        :種類を決める (Random なら毎回選ぶ);
        if (効果音が On?) then (はい)
          :効果音を鳴らす (1回);
        endif
        :揺れを始める (WobbleDur の間);
      endif
    endif
  endif
}

partition "完了のはじける動き (SetBadges)" {
  if (DoneAnimation が On かつ、サンプルでなく、\n進捗のバッジを出している?) then (はい)
    if (前回は完了でなく、今回が完了のシートがある?\n(最初に見たシートは対象外)) then (はい)
      :500ms の動きを始める;
    endif
  endif
}
stop
@enduml
