@startuml
title クラス図: 主なクラスと関係 (v1.7.8)
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype polyline
hide empty members

class ThisAddIn <<VSTO>> {
  -_panes : PaneManager
  #CreateRibbonExtensibilityObject() : IRibbonExtensibility
}

class RibbonController <<IRibbonExtensibility>> {
  +GetCustomUI(ribbonId) : string
  +OnSettingsClick(control)
}

class PaneManager {
  -_collection : CustomTaskPaneCollection
  -_entries : Dictionary<int, Entry>
  -_timer : Timer (300ms)
  +BadgeEventsWanted : Action<bool>
  +EnsurePane(window, workbook)
  +EnsureAllPanes()
  +SyncSheetOf(sheet)
  +ShowSettings()
  +SaveSettings(workbook)
  +MarkBadgesDirty(sheet)
  +Shutdown()
}

class "PaneManager.Entry" as Entry <<ウィンドウごと>> {
  +Pane : CustomTaskPane
  +Window : Excel.Window
  +Workbook : Excel.Workbook
  +Settings : WorkbookSettings
  +Folders : FolderModel
  +History : SheetHistory
  +Badges : Dictionary<string, BadgeInfo>
  +Busy / Syncing / ProtectAsking : bool
  +Failures / AliveRounds : int
}

class TabPaneControl <<UserControl>> {
  -_strip : TabStrip
  -_menu : ContextMenuStrip
  -_folderMenu : ContextMenuStrip
  +ThemeColorProvider : Func<Color[]>
  +MoreColorsProvider : Func<int?>
  +*Requested : event (操作の通知)
}

class TabStrip <<Control>> {
  -_rows : List<StripRow>
  -_names : List<string>
  +SetSheets(names, activeName, selected, colors, rows)
  +SetBadges(info)
  +SetWobble(type, amp, dur)
  +*Requested : event (操作の通知)
  +HistoryProvider : Func<List<HistoryItem>>
  +IsExcelEditing : Func<bool>
  +Arrangement : RowLayout (吊り下げ / 積み上げ)
  +SetLayoutPreview(layout, style, marker)
}

class RowPlacement <<static>> {
  +StackOffset(stacked, areaH, rows, rowPx) : int
  +RowTop(areaTop, offset, index, rowPx, scrollY) : int
  +IndexFromY(y, areaTop, areaBottom, offset, scrollY, rowPx, rows) : int
  +FromBottom(...) / ScrollFromBottom(...) : int
  +WallpaperSpan(...)
}

class TabColorPalette <<Control>> {
  +ColorChosen : event Action<TabColorChoice>
}

class SettingsForm <<Form>> {
  +ShowDialog(owner)
  -(6つのタブ。「背景」は BackgroundPanel)
  -(「基本」は2列。右列は、TabStrip の配置の見本2つ)
}

class BackgroundPanel <<Control>> {
  +Wallpaper : WallpaperOptions
  +RowTransparency : int
  +TextOutline : bool
  +BodyRow(width) : Control
  +EnsurePreview()
  +Refresh()
}

class CropPreview <<Control>> {
  +Crop : WallpaperCrop
  +Rotation : WallpaperRotation
  +LimitCrop : bool
  +FlipImage : bool
  +SetImage(image, crop, rotation, limit, flip)
  +ResetCrop()
  +CropChanged : event
  -(頂点、辺、内側のドラッグ。枠の外は暗くする)
  -(点線の近くの円、ドラッグで画像を回す)
}

class WallpaperRotation <<struct>> {
  +Degrees, Zoom : double
  +Normalize() : WallpaperRotation
  +IsIdentity : bool
  +Format() : string
  +Parse(text) {static}
}

class RotationMath <<static>> {
  +Corners(rotation, bounds) : PointF[]
  +FitZoom(degrees, w, h, areaW, areaH) : double
  +FitFrame(frame, corners, inset) : bool
  +LimitFrame(valid, candidate, corners, inset, move) : RectangleF
}

class WallpaperCrop <<struct>> {
  +L, T, R, B : double
  +Normalize() : WallpaperCrop
  +ToPixels(w, h) : Rectangle
  +Format() : string
  +Parse(text) {static}
}

class CropDrag <<static>> {
  +HitTest(frame, point, grab, canMove) : CropHandle
  +Drag(handle, start, startPt, pt, bounds, minW, minH) : RectangleF
}

class CropPreviewMath <<static>> {
  +FitRect(clientW, clientH, imgW, imgH, margin) : RectangleF
  +ToFrame(crop, bounds) : RectangleF
  +FromFrame(frame, bounds) : WallpaperCrop
}

class Wallpaper <<static>> {
  +Load(path) : Bitmap
  +Layout(srcW, srcH, areaW, areaH, options) : WallpaperLayout
  +Render(source, areaW, areaH, options) : Bitmap
}

class CommentPopup <<static>> {
  +ShowList(screen, owner, items, goTo)
  +ShowContent(screen, owner, item, goTo)
}

class DialogPlacer <<IDisposable>> {
  +DialogPlacer(point)
}

class TabTheme {
  +Current : TabTheme {static}
  +BarBack : Color
}

class DpiHelper <<static>> {
  +GetDpi(window) : int
}

class WobbleMotion <<static>> {
  +At(type, t, amp) : WobbleFrame
  +PickRandom() : WobbleType
}

class WobbleSounds <<static>> {
  +Play(type, volume)
}

ThisAddIn *-- PaneManager
ThisAddIn ..> RibbonController : 作る\n(設定画面を開く Action を渡す)
PaneManager *-- "0..*" Entry : ウィンドウごとに1つ
Entry o-- TabPaneControl : Control
TabPaneControl *-- TabStrip
TabPaneControl ..> TabColorPalette : 作る
TabStrip ..> TabPaneControl : イベント
TabPaneControl ..> PaneManager : イベント
PaneManager ..> SettingsForm : 開く
PaneManager ..> CommentPopup : 表示する
PaneManager ..> DialogPlacer : 「色の設定」の位置
SettingsForm ..> TabStrip : サンプルの描画
TabStrip ..> TabTheme
TabStrip ..> DpiHelper
TabStrip ..> WobbleMotion
TabStrip ..> WobbleSounds
SettingsForm ..> WobbleMotion
SettingsForm *-- BackgroundPanel : 「背景」タブ
BackgroundPanel ..> Wallpaper : 読めるか確かめる
BackgroundPanel *-- CropPreview : 「プレビュー画面」
CropPreview ..> CropDrag : 枠のつかみ方、ドラッグ
CropPreview ..> CropPreviewMath : 画像と枠の位置
CropPreview ..> WallpaperCrop : 枠 (割合)
CropPreview ..> WallpaperRotation : 画像の向きと位置
CropPreview ..> RotationMath : 回転、枠の制限
Wallpaper ..> WallpaperRotation : 回した画像の枠の範囲
Wallpaper ..> WallpaperCrop : 使う範囲
TabStrip ..> Wallpaper : 壁紙の描画
TabStrip ..> RowPlacement : 行の位置の計算
SettingsForm ..> TabStrip : 配置の見本
@enduml
